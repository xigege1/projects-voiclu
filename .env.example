# ===== 站点 =====
NEXT_PUBLIC_SITE_URL=https://voiclu.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@voiclu.com

# ===== IndexNow（Bing / Yandex / Seznam 即时收录推送）=====
# key 本身是公开的（放在 public/<key>.txt 供搜索引擎校验），不是密钥。
# 站点部署成功后运行 `npm run indexnow` 即可把 sitemap 全部 URL 推给 Bing。
SITE_URL=https://voiclu.com
INDEXNOW_KEY=1007d7cf922e9a848e7c2a877e26f699

# ===== TTS 模型（可选）=====
# 默认 eleven_v4（官方 90+ 语言、单次 10,000 字符）。
# 回滚到 eleven_multilingual_v2 时，必须同步把全站 "75+" 文案下调到 29 种语言。
# ELEVENLABS_MODEL_ID=eleven_v4

# ===== Supabase（数据库 + Auth 邮箱验证码）=====
# 在 supabase.com 建项目后，Settings → API 里拷贝
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== ElevenLabs（TTS + Instant Voice Cloning）=====
# elevenlabs.io → 左下角头像 → API Keys。最小权限够用：
#   文本转语音 → 访问；音色 → 写入；用户 → 读取（可选，只影响脚本查额度）
ELEVENLABS_API_KEY=
#
# 【⚠️ 付费账号（Starter 及以上）必须留空】
# 当前账号是 Starter，这一项有值会让 cloneVoice() 直接返回预置声音、跳过真实克隆。
#
# 【仅在免费额度验证阶段才填】
# 免费计划（10k credits/月）不支持 Instant Voice Cloning，克隆接口会 401。
# 填上任一官方预置声音的 voice_id（或任何你账号里已有的 voice_id），
# 克隆步骤就跳过真实 API、改用这个声音，让「上传→存库→合成→转存→播放→计费→缓存」
# 全链路都能零成本跑通。TTS 仍然真实调用、真实消耗免费 credits。
# 升级到 Starter 后清空即可切回真实克隆，代码不用改。
ELEVENLABS_DEMO_VOICE_ID=
#
# 生成首页 / /br 的试听音频（写入 public/demo/，13 个文件约 1063 credits）：
#   npm run demo:audio:dry                     # 先看计划，不调接口
#   npm run demo:audio -- --voice-id <id>      # 用账号里已有声音
#   npm run demo:audio -- --clone ./样本.mp3   # 从自己的录音克隆后生成

# ===== 对象存储（Cloudflare R2，S3 兼容）=====
# R2 → 建 bucket → 开公开访问（绑定 cdn.voiclu.com 或 r2.dev 域名）→ 生成 API Token
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=voiclu-audio
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.voiclu.com

# ===== Creem 支付 webhook 签名密钥 =====
CREEM_WEBHOOK_SECRET=

# ===== 分析（可选，Umami Cloud 或 GA4）=====
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=

# ===== 交易邮件（可选，Resend 免费档每天 100 封）=====
# resend.com → API Keys；不填则邮件静默跳过，不影响主流程
RESEND_API_KEY=
RESEND_FROM=Voiclu <noreply@voiclu.com>
